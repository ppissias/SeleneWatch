# Writes selenewatch_version.h: the release from CMakeLists.txt and the
# source revision. Refreshed on every build; the header only changes when
# the release or the revision changes. This also catches edits or commits
# made without rerunning configuration.
execute_process(COMMAND git describe --always --dirty
    WORKING_DIRECTORY "${SELENEWATCH_SOURCE_DIR}"
    RESULT_VARIABLE result OUTPUT_VARIABLE revision OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
if(NOT result EQUAL 0 OR NOT revision)
    set(revision "unknown")
endif()
string(REPLACE "\\" "\\\\" revision "${revision}")
string(REPLACE "\"" "\\\"" revision "${revision}")
if(NOT SELENEWATCH_RELEASE MATCHES "^([0-9][0-9][0-9][0-9])\\.([0-9][0-9])-([0-9][0-9])$")
    message(FATAL_ERROR "SELENEWATCH_RELEASE must look like 2026.11-01, not '${SELENEWATCH_RELEASE}'")
endif()
# Numbers for the executable's version resource: 2026.11-01 is 2026,11,1,0.
math(EXPR month "${CMAKE_MATCH_2}")
math(EXPR number "${CMAKE_MATCH_3}")
set(content "#pragma once
// Generated by write_version.cmake. The release is set in CMakeLists.txt.
#define SELENEWATCH_RELEASE \"${SELENEWATCH_RELEASE}\"
#define SELENEWATCH_REVISION \"${revision}\"
#define SELENEWATCH_VERSION \"${SELENEWATCH_RELEASE} (${revision})\"
#define SELENEWATCH_VERSION_NUMBERS ${CMAKE_MATCH_1},${month},${number},0
")
set(previous "")
if(EXISTS "${SELENEWATCH_VERSION_HEADER}")
    file(READ "${SELENEWATCH_VERSION_HEADER}" previous)
endif()
if(NOT previous STREQUAL content)
    file(WRITE "${SELENEWATCH_VERSION_HEADER}" "${content}")
endif()
